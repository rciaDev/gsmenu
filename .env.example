# Integração GSMarket Central / DataSnap
# false = chama a Central de verdade (precisa Gateway online + CHAVE)
GSMARKET_USE_MOCK=true

# URL da Central (padrão produção GO)
GSMARKET_CENTRAL_URL=http://91.108.125.249:8090

# PARAMETROS.CHAVE da loja (nunca expor no client)
# GSMARKET_CHAVE=sua-chave-aqui
# ou por tenant:
# GSMARKET_CHAVE_SENZALA=...
# GSMARKET_CNPJ_SENZALA=12345678000199
# GSMARKET_EMPRESA_SENZALA=1

# Base das fotos (Firebase ou HTTP site/imagens/produtos)
# GSMARKET_FOTO_BASE=https://...

# Host usado nos QR Codes (opcional; senão usa o Host da requisição)
# GSMENU_PUBLIC_HOST=senzala.gsmarket.com.br
# GSMENU_PUBLIC_PROTOCOL=https
